<odoo>
    <data noupdate="1">
        <record id="button_aprroval_draft" model="approval.buttons" forcecreate="False">
            <field name="name">Confirm</field>
            <field name="states" eval="['draft']" />
            <field name="settings_id" ref='approval_settings_ticket_management' />
            <field name="action_type">approve</field>
            <field name="button_class">btn-primary</field>
        </record>

        <record id="button_approval_todo" model="approval.buttons">
            <field name="name">TODO</field>
            <field name="settings_id" ref="approval_settings_ticket_management" />
            <field name="config_id" ref="approval_todo" />
            <field name="visible_to">approval</field>
            <field name="action_type">approve</field>
            <field name="button_class">btn-success</field>
        </record>

        <record id="button_approval_in_progress" model="approval.buttons">
            <field name="name">In Progress</field>
            <field name="settings_id" ref="approval_settings_ticket_management" />
            <field name="config_id" ref="approval_in_progress" />
            <field name="visible_to">approval</field>
            <field name="action_type">approve</field>
            <field name="button_class">btn-success</field>
        </record>

        <record id="button_approval_testing" model="approval.buttons">
            <field name="name">Testing</field>
            <field name="settings_id" ref="approval_settings_ticket_management" />
            <field name="config_id" ref="approval_testing" />
            <field name="visible_to">approval</field>
            <field name="action_type">approve</field>
            <field name="button_class">btn-success</field>
        </record>

        <record id="button_approval_resolved" model="approval.buttons">
            <field name="name">Resolved</field>
            <field name="settings_id" ref="approval_settings_ticket_management" />
            <field name="config_id" ref="approval_resolved" />
            <field name="visible_to">approval</field>
            <field name="action_type">approve</field>
            <field name="button_class">btn-success</field>
        </record>
    </data>
</odoo>