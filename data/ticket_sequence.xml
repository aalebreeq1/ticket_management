<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Ticket Auto-Sequence Record -->
        <record id="ticket_sequence" model="ir.sequence">
            <field name="name">Ticket Sequence</field>
            <field name="code">ticket.ticket</field>
            <field name="prefix">TCK/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>