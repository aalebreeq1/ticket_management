<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regular User: Sees tickets where they are assigned OR an approval user -->
        <record id="rule_ticket_user" model="ir.rule">
            <field name="name">User: Own or Approval Tickets</field>
            <field name="model_id" ref="model_ticket_ticket" />
            <field name="domain_force">['|', ('user_id', '=', user.id), ('approval_user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ticket_management.group_ticket_user'))]" />
        </record>

        <!-- Manager: Sees all tickets -->
        <record id="rule_ticket_manager_all" model="ir.rule">
            <field name="name">Manager: All Tickets</field>
            <field name="model_id" ref="model_ticket_ticket" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ticket_management.group_ticket_manager'))]" />
        </record>

    </data>
</odoo>