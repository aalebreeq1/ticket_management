<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 1. Security Groups -->
        <record id="group_ticket_user" model="res.groups">
            <field name="name">Ticket / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ticket_manager" model="res.groups">
            <field name="name">Ticket / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_ticket_user'))]"/>
        </record>

        <!-- 2. Record Rules -->
        <record id="rule_ticket_user" model="ir.rule">
            <field name="name">User: Own or Approval Tickets</field>
            <field name="model_id" ref="model_ticket_ticket"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('approval_user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ticket_user'))]"/>
        </record>

        <record id="rule_ticket_manager_all" model="ir.rule">
            <field name="name">Manager: All Tickets</field>
            <field name="model_id" ref="model_ticket_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ticket_manager'))]"/>
        </record>

    </data>
</odoo>