<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="ticket_view_form" model="ir.ui.view">
            <field name="name">ticket.ticket.view.form</field>
            <field name="model">ticket.ticket</field>
            <field name="arch" type="xml">
                <form string="Ticket">
                    <header>
                        <button name="action_set_new"
                            type="object"
                            class="btn-success"
                            icon="fa-plus"
                            string="Set to New"
                            invisible="stage_id == 1"
                        />
                        <button name="action_in_progress"
                            type="object"
                            class="oe_highlight"
                            string="In Progress"
                            icon="fa-spinner"
                            invisible="stage_id != 1"
                        />
                        <button name="action_pending_customer"
                            type="object"
                            class="btn-warning"
                            string="Pending Customer"
                            icon="fa-clock-o"
                            invisible="stage_id != 2"
                        />
                        <button name="action_resolved"
                            type="object"
                            class="btn-success"
                            string="Resolved"
                            icon="fa-check"
                            invisible="stage_id != 3"
                        />
                        <button name="action_cancelled"
                            type="object"
                            class="btn-danger"
                            string="Cancel Ticket"
                            icon="fa-ban"
                            invisible="stage_id not in [1, 2, 3]"
                        />
                        <button name='action_reset_to_new'
                            type="object"
                            class="btn-secondary"
                            icon="fa-undo"
                            string="Reset to New"
                            invisible="stage_id == 1"
                        />
                        <field name="stage_id" widget="statusbar" options="{'fold_field': 'fold'}"
                            options_clickable="1" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" placeholder="New Ticket Sequence..." />
                            </h1>
                        </div>
                        <group>
                            <group name="left_details">
                                <field name="partner_id" />
                                <field name="category_id" />
                                <field name="tag_ids" widget="many2many_tags"
                                    options="{'color_field': 'color'}" />
                            </group>
                            <group name="right_details">
                                <field name="user_id" widget="many2one_avatar_user" />
                                <field name="priority" widget="priority" />
                                <field name="stage_id" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" widget="html"
                                    placeholder="Add detailed problem description..." />
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter Section -->
                    <chatter>
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </chatter>
                </form>
            </field>
        </record>

        <record id="ticket_view_list" model="ir.ui.view">
            <field name="name">ticket.ticket.view.list</field>
            <field name="model">ticket.ticket</field>
            <field name="arch" type="xml">
                <list string="Tickets">
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="category_id" />
                    <field name="user_id" widget="many2one_avatar_user" />
                    <field name="priority" widget="priority" />
                    <field name="stage_id" />
                    <field name="description" />
                </list>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="ticket_view_kanban" model="ir.ui.view">
            <field name="name">ticket.ticket.view.kanban</field>
            <field name="model">ticket.ticket</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="priority" />
                    <field name="tag_ids" />
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id" />
                                    <div>
                                        <field name="tag_ids" widget="many2many_tags"
                                            options="{'color_field': 'color'}" />
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority" />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user" />
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>