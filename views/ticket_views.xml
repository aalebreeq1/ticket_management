<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="ticket_view_form" model="ir.ui.view">
            <field name="name">ticket.ticket.view.form</field>
            <field name="model">ticket.ticket</field>
            <field name="arch" type="xml">
                <form string="Ticket">
                    <header>
                        <field name="state" widget="statusbar" />
                        <field name="user_can_approve" invisible="1" />
                    </header>
                    <sheet>
                        <group>
                            <field name="title" placeholder="New Ticket Title..."
                                readonly="state not in ['draft']" />
                        </group>

                        <group>
                            <group name="left_details">
                                <field name="partner_id" readonly="state not in ['draft']" />
                                <field name="category_id" readonly="state not in ['draft']" />
                                <field name="tag_ids" widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                                    readonly="state not in ['draft']" />
                            </group>
                            <group name="right_details">
                                <field name="user_id" widget="many2one_avatar_user"
                                    readonly="state not in ['draft']" />
                                <field name="responsible_manager_id" widget="many2one_avatar_user"
                                    readonly="state not in ['draft']" />
                                <field name="priority" widget="priority"
                                    readonly="state not in ['draft']" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" widget="html"
                                    placeholder="Add detailed problem description..."
                                    readonly="state not in ['draft']" />
                            </page>
                        </notebook>
                    </sheet>
                    <chatter>
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </chatter>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="ticket_view_list" model="ir.ui.view">
            <field name="name">ticket.ticket.view.list</field>
            <field name="model">ticket.ticket</field>
            <field name="arch" type="xml">
                <list string="Tickets">
                    <field name="ticket_ref" />
                    <field name="title" />
                    <field name="partner_id"/>
                    <field name="user_id" widget="many2one_avatar_user" />
                    <field name="responsible_manager_id" widget="many2one_avatar_user" />
                    <field name="state" widget="badge"
                        decoration-warning="state == 'draft'"
                        decoration-info="state == 'in_progress'"
                        decoration-primary="state == 'todo'"
                        decoration-muted="state == 'testing'"
                        decoration-success="state in ['approved','resolved']"
                        decoration-danger="state == 'cancelled'"
                    />
                    <field name="category_id" optional="hide" />
                    <field name="priority" widget="priority" optional="hide" />


                </list>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="ticket_view_kanban" model="ir.ui.view">
            <field name="name">ticket.ticket.view.kanban</field>
            <field name="model">ticket.ticket</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" sample="1" records_draggable="false">
                    <field name="ticket_ref" />
                    <field name="title" />
                    <field name="partner_id"/>
                    <field name="priority" />
                    <field name="tag_ids" />
                    <field name="user_id" />
                    <field name="responsible_manager_id" />
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="title" />
                                    </strong>
                                    <div>
                                        <field name="ticket_ref" />
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id"/>
                                    <div>
                                        <field name="tag_ids" widget="many2many_tags"
                                            options="{'color_field': 'color'}" />
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority" />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user" />
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>
</odoo>