<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==================== WINDOW ACTIONS ==================== -->

        <!-- 1. All Tickets Action -->
        <record id="action_ticket_all" model="ir.actions.act_window">
            <field name="name">All Tickets</field>
            <field name="res_model">ticket.ticket</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tickets found. Let's create one!
                </p>
            </field>
        </record>

        <!-- 2. My Tickets Action (Pre-filtered) -->
        <record id="action_ticket_my" model="ir.actions.act_window">
            <field name="name">My Tickets</field>
            <field name="res_model">ticket.ticket</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_my_tickets': 1}</field>
        </record>

        <!-- 3. Categories Action -->
        <record id="action_ticket_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">ticket.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- 4. Stages Action -->
        <record id="action_ticket_stage" model="ir.actions.act_window">
            <field name="name">Stages</field>
            <field name="res_model">ticket.stage</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- 5. Tags Action -->
        <record id="action_ticket_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">ticket.tag</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- ==================== MENU  ==================== -->

        <menuitem id="menu_ticket_root"
            name="Tickets"
            sequence="10" />

        <menuitem id="menu_ticket_operations"
            name="Tickets"
            parent="menu_ticket_root"
            sequence="10" />

        <menuitem id="menu_ticket_all"
            name="All Tickets"
            parent="menu_ticket_operations"
            action="action_ticket_all"
            groups="group_ticket_manager"
            sequence="10" />

        <menuitem id="menu_ticket_my"
            name="My Tickets"
            parent="menu_ticket_operations"
            action="action_ticket_my"
            sequence="20" />

        <menuitem id="menu_ticket_configuration"
            name="Configuration"
            parent="menu_ticket_root"
            groups="group_ticket_manager"
            sequence="100" />

        <menuitem id="menu_ticket_category"
            name="Categories"
            parent="menu_ticket_configuration"
            action="action_ticket_category"
            sequence="10" />

        <menuitem id="menu_ticket_stage"
            name="Stages"
            parent="menu_ticket_configuration"
            action="action_ticket_stage"
            sequence="20" />

        <menuitem id="menu_ticket_tag"
            name="Tags"
            parent="menu_ticket_configuration"
            action="action_ticket_tag"
            sequence="30" />

    </data>
</odoo>