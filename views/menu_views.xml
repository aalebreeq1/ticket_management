<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ACTIONS -->

        <record id="action_ticket_all" model="ir.actions.act_window">
            <field name="name">All Tickets</field>
            <field name="res_model">ticket.ticket</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="action_ticket_my" model="ir.actions.act_window">
            <field name="name">My Tickets</field>
            <field name="res_model">ticket.ticket</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('user_id', '=', uid)]</field>
            <field name="group_ids" eval="[(4, ref('ticket_management.group_ticket_user'))]"/>

        </record>

        <record id="action_ticket_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">ticket.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_ticket_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">ticket.tag</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- MENU  -->

        <menuitem id="menu_ticket_root"
            name="Tickets"
            sequence="10" />

        <menuitem id="menu_ticket_all"
            name="All Tickets"
            parent="menu_ticket_root"
            action="action_ticket_all"
            groups="group_ticket_manager"
            sequence="20" />

        <menuitem id="menu_ticket_my"
            name="My Tickets"
            parent="menu_ticket_root"
            action="action_ticket_my"
            groups="ticket_management.group_ticket_user"
            sequence="30"
        />


        <menuitem id="menu_ticket_configuration"
            name="Configuration"
            parent="menu_ticket_root"
            groups="group_ticket_manager"
            sequence="100" />

        <menuitem id="menu_ticket_category"
            name="Categories"
            parent="menu_ticket_configuration"
            action="action_ticket_category"
            sequence="10" />

        <menuitem id="menu_ticket_tag"
            name="Tags"
            parent="menu_ticket_configuration"
            action="action_ticket_tag"
            sequence="30" />

    </data>
</odoo>