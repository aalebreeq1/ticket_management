<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Category Views -->
        <record id="ticket_category_view_form" model="ir.ui.view">
            <field name="name">ticket.category.view.form</field>
            <field name="model">ticket.category</field>
            <field name="arch" type="xml">
                <form string="Category">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ticket_category_view_list" model="ir.ui.view">
            <field name="name">ticket.category.view.list</field>
            <field name="model">ticket.category</field>
            <field name="arch" type="xml">
                <list string="Categories">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- Ticket Stage Views -->
        <record id="ticket_stage_view_form" model="ir.ui.view">
            <field name="name">ticket.stage.view.form</field>
            <field name="model">ticket.stage</field>
            <field name="arch" type="xml">
                <form string="Stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="is_closed"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ticket_stage_view_list" model="ir.ui.view">
            <field name="name">ticket.stage.view.list</field>
            <field name="model">ticket.stage</field>
            <field name="arch" type="xml">
                <list string="Stages">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="state"/>
                    <field name="is_closed"/>
                </list>
            </field>
        </record>

        <!-- Tag Views -->
        <record id="ticket_tag_view_form" model="ir.ui.view">
            <field name="name">ticket.tag.view.form</field>
            <field name="model">ticket.tag</field>
            <field name="arch" type="xml">
                <form string="Tag">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ticket_tag_view_list" model="ir.ui.view">
            <field name="name">ticket.tag.view.list</field>
            <field name="model">ticket.tag</field>
            <field name="arch" type="xml">
                <list string="Tags">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

    </data>
</odoo>