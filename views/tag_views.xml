<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ticket_tag_view_list" model="ir.ui.view">
            <field name="name">ticket.tag.view.list</field>
            <field name="model">ticket.tag</field>
            <field name="arch" type="xml">
                <list string="Tags" editable="bottom">
                    <field name="name" />
                    <field name="code" />
                    <field name="color" widget="color_picker" />
                </list>
            </field>
        </record>

    </data>
</odoo>